# SocialPilot Enterprise Platform - Production Environment Template

# Project Specification
PROJECT_NAME="SocialPilot Enterprise Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Database Connections
POSTGRES_SERVER=postgres
POSTGRES_USER=socialpilot
POSTGRES_PASSWORD=socialpilot_pass_secure_2026
POSTGRES_DB=socialpilot_db
POSTGRES_PORT=5432

MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=socialpilot_analytics

REDIS_URL=redis://redis:6379/0

# Security Cryptography Vault
SECRET_KEY=production_jwt_secret_key_change_in_production_32bytes
FERNET_KEY=production_fernet_aes256_key_must_be_32_url_safe_base64_bytes=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Official Social Platform OAuth Credentials
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# AWS S3 Media Storage Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=socialpilot-media-vault
AWS_S3_REGION=us-east-1

# SMTP Email Dispatch Server Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@socialpilot.com
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM_EMAIL=notifications@socialpilot.com
