# SocialPilot Environment Variables

PROJECT_NAME=SocialPilot
API_V1_STR=/api/v1

# Security Keys - Generate secure random keys in production (e.g. openssl rand -hex 32)
SECRET_KEY=SUPER_SECRET_KEY_REPLACE_IN_PRODUCTION_1234567890
ENCRYPTION_KEY=dGVzdF9rZXlfdGVzdF9rZXlfdGVzdF9rZXlfdGVzdF9rZXk=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite local: sqlite:///./socialpilot.db
# PostgreSQL: postgresql://username:password@localhost:5432/socialpilot
DATABASE_URL=sqlite:///./socialpilot.db

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
